# chapter 8 (ch08:247-260), verbatim except line 6, a note from this repo. Copy it to your project as .env.example; put real values only in .env.
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/myapp_dev

# External APIs
# Only if your API needs a key. Open-Meteo, the chapter 4 API, needs none.
WEATHER_API_KEY=your_openweathermap_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App Config
NODE_ENV=development
PORT=3000
SESSION_SECRET=generate_a_random_string_here
